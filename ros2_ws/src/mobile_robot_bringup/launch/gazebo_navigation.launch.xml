<launch>


<let name="urdf_path" value="$(find-pkg-share mobile_robot_description)/URDF/MineMapper.urdf.xacro"/>
<let name="rviz_config_path" value="$(find-pkg-share mobile_robot_bringup)/config/std_display_config.rviz"/>
<let name="gazebo_config_path" value="$(find-pkg-share mobile_robot_bringup)/config/gazebo_bridge.yaml"/>
<let name="world_path" value="$(find-pkg-share mobile_robot_bringup)/worlds/test_world.world"/>

<node pkg="robot_state_publisher" exec="robot_state_publisher">
    <param name="robot_description" value="$(command 'xacro $(var urdf_path)')"/>
</node>

<include file="$(find-pkg-share ros_gz_sim)/launch/gz_sim.launch.py">
    <arg name="gz_args" value="$(var world_path) -r"/>
    <!-- <arg name="gz_args" value="empty.sdf -r"/> -->

</include>

<node pkg="ros_gz_sim" exec="create" args="-topic robot_description -x 0 -y 0 -z 0.3"/>

<node pkg="ros_gz_bridge" exec="parameter_bridge">
    <param name="config_file" value="$(var gazebo_config_path)"/>
</node>

<node pkg="rviz2" exec="rviz2" output="screen" args="-d $(var rviz_config_path)"/>


<include file="$(find-pkg-share nav2_bringup)/launch/bringup_launch.py">
  <arg name="map" value="$(find-pkg-share mobile_robot_bringup)/mobile_robot_bringup/worlds/world_map.yaml"/>
  <arg name="use_sim_time" value="true"/>
</include>
 
    <!-- <node pkg="slam_toolbox" exec="async_slam_toolbox_node" name="slam_toolbox" output="screen">
        <param name="use_sim_time" value="true"/>
        <param name="slam_params_file" value="$(find your_package)/config/slam_toolbox_params_online.yaml"/>
        <remap from="scan" to="/scan"/>
    </node>  -->
</launch>